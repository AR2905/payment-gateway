# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored (see .gitignore) so your secrets stay private.
# ---------------------------------------------------------------------------

# 1) MongoDB Atlas connection string.
#    Atlas dashboard: Database -> Connect -> Drivers -> copy the `mongodb+srv://` string.
#    Include the database name in the path (here: `razorpay-demo`).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/razorpay-demo?retryWrites=true&w=majority"

# 2) Razorpay API keys (TEST mode while learning).
#    Razorpay dashboard: Account & Settings -> API Keys -> Generate Test Key.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# 3) Razorpay webhook secret.
#    Razorpay dashboard: Account & Settings -> Webhooks -> Add New Webhook.
#    Endpoint URL: https://<your-public-url>/api/razorpay/webhook
#    Active events: payment.captured, payment.failed, order.paid
#    Then set a secret here and use the SAME value in the dashboard.
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
